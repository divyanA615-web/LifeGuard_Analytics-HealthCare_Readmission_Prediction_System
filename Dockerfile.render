# syntax=docker/dockerfile:1.6
# Render-optimized backend image.
#
# Design notes:
#   * Build context = repo root (because Render clones the repo and reads
#     Dockerfile at root by default). See render.yaml: dockerfilePath etc.
#   * Model artifacts are NOT baked into this image. Render mounts a persistent
#     volume at /app/ml/models and /app/ml/data/features at deploy time.
#   * This avoids mixing PHI-trained weights into a Docker layer (safety).
# ============================================================================

FROM python:3.11-slim AS builder

WORKDIR /build

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# ---------------------------------------------------------------------------

FROM python:3.11-slim AS runtime

WORKDIR /app

ENV ENVIRONMENT=prod \
    PYTHONUNBUFFERED=1 \
    MODEL_ARTIFACT_PATH=/app/ml/models/xgboost_v1

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Application code & migrations (paths relative to repo ROOT because context='.')
COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./alembic.ini
COPY backend/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Feature metadata loaded at runtime (lightweight constants only)
COPY ml/data/features/feature_columns.json ./ml/data/features/feature_columns.json
COPY ml/__init__.py ./ml/__init__.py
COPY ml/models/__init__.py ./ml/models/__init__.py
COPY ml/models/inference.py ./ml/models/inference.py
COPY ml/models/shap_explainer.py ./ml/models/shap_explainer.py

EXPOSE 8080
HEALTHCHECK CMD python -c "import os, urllib.request, sys; port=os.environ.get('PORT','8080'); sys.exit(urllib.request.urlopen(f'http://localhost:{port}/v1/health').status != 200)"

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080} --proxy-headers --log-level info"]
