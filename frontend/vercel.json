{
  "version": 2,
  "name": "lifeguard-readmission-frontend",
  "rewrites": [
    { "source": "/v1/(.*)", "destination": "https://your-backend-host.onrender.com/v1/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}